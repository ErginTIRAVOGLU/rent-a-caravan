{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // designs/ bağımsız mockup projeleri: kendi package.json + tsconfig'leri var,
  // root bağımlılıklarıyla derlenemezler (lucide-react vb. root'ta yok).
  // Include deseni (`**/*.tsx`) bunları yutmasın diye burada dışlanır.
  "exclude": ["node_modules", "designs"]
}
